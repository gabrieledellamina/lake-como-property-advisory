---
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = [
 {n:'01',title:'Tax & Relocation Advisory',href:'/services/tax-advisory/',desc:'Access to a trusted network of tax advisers, lawyers and specialists for international clients considering a move to Italy.',img:'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=85',alt:'Professional reviewing financial documents'},
 {n:'02',title:'Project Management',href:'/services/project-management/',desc:'Feasibility, design coordination, cost estimates, building permits and professional-team management.',img:'https://images.unsplash.com/photo-1503387762-592eda58ef23?auto=format&fit=crop&w=1200&q=85',alt:'Architectural project drawings'},
 {n:'03',title:'Construction Management',href:'/services/construction-management/',desc:'Technical and economic site management, progress monitoring, quality standards and coordination of contractors.',img:'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=85',alt:'Construction professionals at work'},
 {n:'04',title:'Real Estate Due Diligence & Valuation',href:'/services/due-diligence/',desc:'A structured assessment of property, condition, planning considerations, risks and market value, with reference to IVS where appropriate.',img:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85',alt:'Contemporary villa with garden'},
];
---
<BaseLayout title="Services | Lake Como Property Advisory" active="services" description="Property, tax-adviser coordination, project management, construction management and due diligence services around Lake Como.">
  <section class="page-hero"><div class="container"><div class="breadcrumb">Home / Services</div><span class="eyebrow">A considered approach</span><h1 style="font-size:clamp(45px,7vw,82px);margin-top:20px">Clarity at every<br />stage of ownership.</h1><p class="lead">From the first question to the final detail, we help bring the right people, information and decisions together.</p></div></section>
  <section class="section"><div class="container services-grid">{items.map((s)=><article class="service-card"><a href={s.href}><div class="image-wrap"><img src={s.img} alt={s.alt} loading="lazy" /></div></a><div class="service-card-body"><div class="service-number">{s.n} / OUR SERVICES</div><h3>{s.title}</h3><p>{s.desc}</p><a class="text-link" href={s.href}>Discover the service <span>↗</span></a></div></article>)}</div></section>
  <section class="section" style="background:#e9e8df"><div class="container" style="max-width:850px;text-align:center"><span class="eyebrow">A tailored engagement</span><h2 style="margin-top:18px">Your project is unique.<br />Your support should be too.</h2><p class="lead" style="margin:0 auto 28px">The scope is defined around your property, priorities and stage of decision-making. We coordinate with qualified local professionals wherever specialist advice or statutory appointments are required.</p><a class="btn" href="/#contact">Discuss your requirements <span>↗</span></a></div></section>
</BaseLayout>
