---
import BaseLayout from '../layouts/BaseLayout.astro';
const features = [
 {title:'Historic villas & living heritage',desc:'Grand waterfront residences, gardens, stone villages and a long architectural tradition create a distinctive sense of place.',img:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=85',alt:'Elegant villa and garden'},
 {title:'Life on the water',desc:'Sailing, boating, swimming and lakeside walks bring the landscape into everyday life, from quiet mornings to long summer evenings.',img:'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1100&q=85',alt:'Sunlit blue water'},
 {title:'Mountains, trails & open air',desc:'The lake meets the Alps: hiking, cycling, climbing and winter sports are all within reach, depending on the season and location.',img:'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1100&q=85',alt:'Mountain peaks and alpine landscape'},
 {title:'A connected location',desc:'Milan offers international connections, culture and business; St. Moritz and the Engadin add a distinctive alpine dimension to the wider region.',img:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=85',alt:'Contemporary villa architecture in a landscaped setting'},
];
---
<BaseLayout title="The Lake Como Lifestyle | Lake Como Property Advisory" active="lifestyle" description="Explore Lake Como's historic villas, water sports, natural beauty and strategic proximity to Milan and St. Moritz.">
  <section class="page-hero"><div class="container"><div class="breadcrumb">Home / Lake Como lifestyle</div><span class="eyebrow">A place with its own rhythm</span><h1 style="margin-top:20px">More than a view.<br />A way of life.</h1><p class="lead">A remarkable combination of heritage, water, mountains and culture — with the everyday convenience of a well-connected Northern Italian location.</p></div></section>
  <div class="page-hero-image"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=88" alt="Elegant contemporary villa architecture near Lake Como" /></div>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Discover the region</span><h2 style="margin-top:18px">A landscape of contrasts.</h2><p class="lead">Each part of the lake has its own character, from the quieter northern shores to the historic towns and villages around Como and Lecco.</p></div></div><div class="lifestyle-grid">{features.map((f)=><article><img src={f.img} alt={f.alt} loading="lazy" /><h3>{f.title}</h3><p>{f.desc}</p></article>)}</div></div></section>
  <section class="split-feature"><img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=85" alt="Scenic mountain landscape in northern Italy" loading="lazy" /><div class="split-feature-copy"><span class="eyebrow">The right location is personal</span><h2>Find your side<br />of the lake.</h2><p>Some clients are drawn to privacy and open landscapes in the upper lake; others prefer the cultural life, services and transport connections of Como or Lecco. The best choice depends on how you want to live, travel and use your property.</p><a class="btn" href="/#contact">Tell us what matters to you <span>↗</span></a></div></section>
</BaseLayout>
