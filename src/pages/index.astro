---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
const services = [
 {n:'01',title:'Tax & Relocation Advisory',desc:'A carefully coordinated introduction to trusted tax and legal professionals for international clients considering Italy.',href:'/services/tax-advisory/',img:'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1000&q=85',alt:'Professional reviewing documents at a desk'},
 {n:'02',title:'Project Management',desc:'From early feasibility and cost planning to permits, consultant coordination and clear decision-making.',href:'/services/project-management/',img:'https://images.unsplash.com/photo-1503387762-592eda58ef23?auto=format&fit=crop&w=1000&q=85',alt:'Architectural plans and project drawings'},
 {n:'03',title:'Construction Management',desc:'Technical and commercial oversight on site, with attention to workmanship, programme and budget.',href:'/services/construction-management/',img:'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1000&q=85',alt:'Construction site with professionals at work'},
 {n:'04',title:'Real Estate Due Diligence & Valuation',desc:'A structured view of property condition, constraints, risks and value, informed by International Valuation Standards.',href:'/services/due-diligence/',img:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=85',alt:'Contemporary luxury residence'},
];
---
<BaseLayout title="Lake Como Property Advisory | Italian Life, Swiss Quality" description="Independent property, project and construction advisory for international clients on Lake Como.">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="eyebrow">Property & construction advisory · Lake Como, Italy</span>
      <h1>Italian life.<br /><em>Swiss quality.</em></h1>
      <p>Independent guidance for international clients who want to buy, build or transform property on Lake Como — with clarity, control and care at every stage.</p>
      <div class="hero-actions"><a class="btn btn-light" href="#contact">Discuss your project <span aria-hidden="true">↗</span></a><a class="text-link" href="/services/" style="color:white">Explore our services</a></div>
    </div>
    <div class="hero-note">A considered approach to property</div>
  </section>

  <section class="anniversary-section" aria-label="20 years of experience">
    <div class="container anniversary-inner">
      <div class="anniversary-number" aria-hidden="true">20</div>
      <div class="anniversary-copy">
        <span class="eyebrow">2005 — 2025</span>
        <h2>20 Years of Experience</h2>
        <p>Two decades of expertise in construction, project management and real estate.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container intro-grid">
      <div><span class="eyebrow">A local perspective. An international mindset.</span><h2 style="margin-top:22px">Make your vision<br />feel effortless.</h2></div>
      <div class="intro-copy"><p class="lead">The Lake Como property journey should be inspiring — not overwhelming.</p><p>We help international owners and investors navigate the practical complexity behind exceptional property: the right professionals, realistic costs, planning procedures, site decisions and quality control.</p><p>One trusted point of coordination, from first conversation to final handover, with an independent and transparent approach.</p><a class="text-link" href="/services/">Discover how we work <span>↗</span></a></div>
      <div class="intro-image"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85" alt="Refined contemporary residential architecture" loading="lazy" /></div>
      <div class="intro-copy" style="align-self:center"><span class="eyebrow">The principle</span><h3 style="font-size:34px;margin-top:15px">Good decisions begin with a clear picture.</h3><p>We bring structure to complex projects, making scope, cost, timing and responsibilities easier to understand before commitments are made.</p></div>
    </div>
  </section>

  <section class="section" style="background:#eeece5">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">Our expertise</span><h2 style="margin-top:18px">The right expertise.<br />Coordinated around you.</h2><p class="lead">A tailored set of services for property decisions and projects of lasting value.</p></div><a class="text-link" href="/services/">All services <span>↗</span></a></div>
      <div class="services-grid">
        {services.map((s)=><article class="service-card"><a href={s.href}><div class="image-wrap"><img src={s.img} alt={s.alt} loading="lazy" /></div></a><div class="service-card-body"><div class="service-number">{s.n} / ADVISORY</div><h3>{s.title}</h3><p>{s.desc}</p><a class="text-link" href={s.href}>Explore service <span>↗</span></a></div></article>)}
      </div>
    </div>
  </section>

  <section class="split-feature">
    <img src="https://images.unsplash.com/photo-1734173071981-b16ee4f9867f?auto=format&fit=crop&w=1400&q=85" alt="Villa del Balbianello, Lake Como" loading="lazy" />
    <div class="split-feature-copy"><span class="eyebrow">Beyond the property</span><h2>A place to live.<br />A way to feel.</h2><p class="lead">Historic villas, alpine landscapes, life on the water and a rare balance between privacy and connection.</p><p>From the villages of the upper lake to Como and Lecco, discover a region with its own rhythm — and convenient connections to Milan and St. Moritz.</p><a class="text-link" href="/lifestyle/">Discover the Lake Como lifestyle <span>↗</span></a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">Notes & perspectives</span><h2 style="margin-top:18px">Informed decisions<br />start with insight.</h2><p>Selected perspectives on property, investment and life in Italy.</p></div><a class="text-link" href="/journal/">Visit the journal <span>↗</span></a></div>
      <div class="article-list">
        <article class="article-card"><a href="/journal/italy-flat-tax-300000-euro/"><img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1000&q=85" alt="Documents on a desk" loading="lazy" /></a><div class="article-card-body"><div class="article-meta">Tax & relocation · 6 min read</div><h3><a href="/journal/italy-flat-tax-300000-euro/">Italy’s €300,000 flat tax: what international residents should know</a></h3><p>A concise introduction to Italy’s lump-sum tax regime for eligible new residents, and why individual advice matters.</p><a class="text-link" href="/journal/italy-flat-tax-300000-euro/">Read article <span>↗</span></a></div></article>
        <article class="article-card"><a href="/lifestyle/"><img src="https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1000&q=85" alt="Sunlight on water" loading="lazy" /></a><div class="article-card-body"><div class="article-meta">Lifestyle · Lake Como</div><h3><a href="/lifestyle/">The Lake Como way of life</a></h3><p>Water, mountains, heritage and culture — a setting that makes a property more than an address.</p><a class="text-link" href="/lifestyle/">Explore the region <span>↗</span></a></div></article>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contact">
    <div class="container contact-grid">
      <div><span class="eyebrow">Start a conversation</span><h2 style="margin-top:20px">Tell us what<br />you have in mind.</h2><p class="lead">Whether you are exploring the market or ready to move forward, a first conversation can help bring your priorities into focus.</p><p>Share a few details below. We will use them to understand your plans and respond appropriately.</p><div class="stats-row" style="grid-template-columns:1fr"><div class="stat"><strong>Independent</strong><span>Advice shaped around your interests</span></div><div class="stat"><strong>Coordinated</strong><span>The right specialists for each decision</span></div><div class="stat"><strong>Lake Como</strong><span>Local knowledge, international perspective</span></div></div></div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
